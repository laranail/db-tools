includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - src
    excludePaths:
        - vendor
    ignoreErrors:
        # larastan validates a view-string literal against a skeleton app that never
        # boots this package's provider, so a namespace registered at RUNTIME is
        # invisible to it and every `view()` / `View::make()` call reads as an error.
        # The views exist; the suite renders them. Broad on purpose -- the narrow
        # forms missed `static method`, `Contracts\View\Factory` and the helper,
        # each of which had to be discovered from a red run.
        - '#expects view-string, string given#'
        # Generic array value types in docblocks are not enforced (the public
        # API uses plain `array` throughout); not a correctness concern.
        -
            identifier: missingType.iterableValue
        # `Has*`/`Interacts*` traits are exposed for consumer models/classes;
        # they have no internal callers in this library by design.
        -
            identifier: trait.unused
        # SQL restore runs statements parsed from a backup file; they are
        # intentionally dynamic, not literal-string.
        -
            identifier: argument.type
            path: src/Backup/SqlFileRestorer.php
        # The archive scope dispatches builder/model methods supplied by the
        # HasArchiver trait at runtime (the same pattern as Laravel's own
        # SoftDeletingScope) — not statically resolvable.
        -
            identifier: method.notFound
            path: src/Schema/Scopes/ArchiveScope.php
        # addSeoFields() delegates to the sibling addMetaFields() Blueprint macro
        # registered alongside it; macro methods are invisible to the analyser.
        -
            identifier: method.notFound
            path: src/Schema/FieldGroupMacros.php
    treatPhpDocTypesAsCertain: false

    # Required BECAUSE of the ignore above: only larastan 3.x emits that error, so
    # where an older one is installed the pattern would itself become an
    # unmatched-ignore ERROR -- moving the failure rather than fixing it.
    reportUnmatchedIgnoredErrors: false
